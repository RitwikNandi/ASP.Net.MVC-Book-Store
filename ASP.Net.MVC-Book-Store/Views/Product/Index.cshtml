@using Book_Store_Models
@model List<Product>

<div class="container">

    <div class="row pt-4 pb-3">
        <div class="col-6">
            <h2 class="text-primary">Product list</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Product" asp-action="UpsertProducts" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Create New Category</a>
        </div>
    </div>
    <table id="productTable" class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                <td>Title</td>
                <td>ISBN</td>
                <td>Author</td>
                <td>Price</td>
                <td>Category</td>
                <th></th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
    <script src="~/js/product.js"></script>
}